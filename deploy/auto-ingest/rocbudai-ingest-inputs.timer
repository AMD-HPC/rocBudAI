[Unit]
Description=rocBudAI — periodic KB ingest
Documentation=man:rocbudai(1)
# Sole trigger for the ingest: we ship no systemd.path watcher, whose implicit
# NFS-mount dependency can cause a boot-time ordering cycle on infra nodes (see
# the deploy README). 1-hour cadence trades in-session lag against NFS scans.

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
Persistent=true
Unit=rocbudai-ingest-inputs.service

[Install]
WantedBy=timers.target
